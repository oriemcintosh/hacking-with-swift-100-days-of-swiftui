# macOS
.DS_Store
.AppleDouble
.LSOverride

# Xcode
# User settings
xcuserdata/
*/xcuserdata/
*.xcuserstate

# Workspace / project
*.xcworkspace           # comment out if you intentionally commit workspace (e.g. CocoaPods-managed)
xcshareddata/

# Build products / caches
DerivedData/
build/
*.o
*.linkfilelist
*.hmap
*.ipa
*.dSYM
*.dSYM.zip

# Playgrounds
timeline.xctimeline
playground.xcworkspace
contents.xcplayground
playground.xcplayground
timeline.xctimeline

# Swift Package Manager
.build/
# .swiftpm                 # uncomment only if you want to ignore SwiftPM package files
# Package.pins             # optional - many teams keep Package.resolved for reproducible builds
# Package.resolved         # recommended to commit for apps/libraries to ensure deterministic builds

# CocoaPods (optional)
# Pods/                    # uncomment if you don't want to check in CocoaPods sources
# *.xcworkspace            # if you're using CocoaPods and want to commit the generated workspace, keep this line commented

# Carthage (optional)
Carthage/Build/
# Carthage/Checkouts       # optional - uncomment to ignore checkouts

# fastlane (optional)
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# Editors / IDEs
.vscode/
.idea/
*.swp
*~
*.tmp
*.log

# Archives / exported files
*.zip
*.tar.gz

# Misc
.env
.env.*.local
*.local
*.orig

# Ignore files created by other tools
*.xcscmblueprint
*.xccheckout

# Temporary files from playground or editor sessions
playground.shareddata
